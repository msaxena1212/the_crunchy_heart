PORT=5000
HOST=127.0.0.1
# AWS RDS PostgreSQL (or any PostgreSQL host). Use sslmode=verify-full on AWS.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-RDS-ENDPOINT:5432/DBNAME?sslmode=verify-full
# Path to the AWS RDS CA bundle (global-bundle.pem) for certificate verification.
DATABASE_SSL_CA_PATH=
CLIENT_URL=http://localhost:4200
TRUST_PROXY=1

# Secrets: set these in the secret manager or the process environment. Never commit values.
# Each must be at least 32 characters. Production startup rejects missing or short
# ORDER_TOKEN_SECRET and OWNER_SESSION_SECRET.
ORDER_TOKEN_SECRET=
OWNER_SESSION_SECRET=
RECOVERY_CODE_SECRET=

# Cashfree Gateway Credentials
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_API_VERSION=2025-01-01
CASHFREE_RETURN_URL=http://localhost:4200/payment/callback
CASHFREE_WEBHOOK_URL=http://localhost:5000/api/payments/cashfree/webhook

# Background workers. Each starts only when its flag is exactly "true". Leave them unset
# (disabled) until a deployment decision enables them. Never enable them in the first AWS rehearsal.
# RECONCILIATION_WORKER_ENABLED=false
# REFUND_WORKER_ENABLED=false
# OPS_ALERTS_ENABLED=false

# Production Email (SMTP) Configuration
# OPS_ALERT_EMAIL_PROVIDER=smtp
# OPS_ALERT_EMAIL_FROM=orders@thecrunchyheart.com
# OPS_ALERT_EMAIL_TO=ops@thecrunchyheart.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
