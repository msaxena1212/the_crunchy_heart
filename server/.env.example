# Copy these values into the repository-root .env.local file.
# The server currently loads .env.local from the repository root.
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
CLIENT_URL=http://localhost:4200

# Cashfree Payment Gateway
# Use sandbox credentials until checkout has been verified end-to-end.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_API_VERSION=2025-01-01
CASHFREE_RETURN_URL=http://localhost:4200/payment/callback
CASHFREE_WEBHOOK_URL=http://localhost:5000/api/payments/cashfree/webhook
