# ==============================================================================
# The Crunchy Heart — Production AWS Environment File Template
# Location on EC2: /etc/thecrunchyheart/api.env (chmod 600, owned by tch-api)
# Never commit actual production secrets to git.
# ==============================================================================

NODE_ENV=production
PORT=5000
HOST=127.0.0.1
CLIENT_URL=https://thecrunchyheart.com
TRUST_PROXY=1

# AWS RDS PostgreSQL Connection URL (force SSL verify-full)
# e.g.: postgresql://tch_prod_app:<password>@<rds-endpoint>.ap-south-1.rds.amazonaws.com:5432/crunchy_heart?sslmode=verify-full
DATABASE_URL=
DATABASE_SSL_CA_PATH=/etc/ssl/certs/global-bundle.pem

# Cryptographic Secrets (MUST be at least 32 characters, distinct from each other)
ORDER_TOKEN_SECRET=
OWNER_SESSION_SECRET=
RECOVERY_CODE_SECRET=

# Cashfree Production Gateway Credentials
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=production
CASHFREE_API_VERSION=2025-01-01
CASHFREE_RETURN_URL=https://thecrunchyheart.com/payment/callback
CASHFREE_WEBHOOK_URL=https://thecrunchyheart.com/api/payments/cashfree/webhook

# Background Workers (Disabled by default; enable after deployment validation)
RECONCILIATION_WORKER_ENABLED=false
REFUND_WORKER_ENABLED=false
OPS_ALERTS_ENABLED=false

# Production Email (SMTP) Configuration for Alerts & Recovery Codes
OPS_ALERT_EMAIL_PROVIDER=smtp
OPS_ALERT_EMAIL_FROM=orders@thecrunchyheart.com
OPS_ALERT_EMAIL_TO=ops@thecrunchyheart.com
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

